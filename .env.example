# =============================================================================
# Assistant — Environment Variables
# =============================================================================
#
# You normally do NOT copy this file. Run ./setup.sh: it creates and
# maintains data/.env (non-secret settings), data/.secrets/ (credentials) and
# data/.compose-secrets.yaml, preserving anything it does not manage.
#
# This template is a reference for the settings the wizard writes to .env, for
# users who prefer to prepare a .env by hand. Never put credentials here.
#
# Where settings belong:
#   data/.env      Wizard-managed settings, plus Docker Compose variables
#                  (COMPOSE_PROFILES, TASK_AGENT_WORKERS,
#                  SANDBOX_ISOLATION_MODE) that Compose reads only from this file.
#   data/overrides.env  Optional, hand-edited file for expert settings the wizard does
#                  not manage (see below). Never rewritten by setup.
#   data/.secrets/ Credentials: ./setup.sh secrets update
#
# Override precedence (highest wins):
#   1. docker-compose.yml `environment:` entries
#   2. overrides.env (loaded after .env)
#   3. .env (this file)
#   4. data/config/agent.yaml (initialized from src/config/agent.yaml)
#   5. Code-level fallback defaults
#
# Expert overrides: create overrides.env next to this file (setup also creates a
# commented template on first save) with one NAME=value line per setting listed
# in docs/env-overrides.md, then run `docker compose --env-file data/.env up -d --force-recreate`.
# Do not repeat settings the wizard manages; the setup review rejects them.
#
# =============================================================================


# =============================================================================
# CREDENTIALS — Managed through ./setup.sh secrets update
# =============================================================================

# Setup creates protected data/.secrets files and data/.compose-secrets.yaml. Credentials
# are mounted under /run/secrets only in services that need them. Compose does
# not encrypt source files.
# Never set both NAME and NAME_FILE for the same credential.

# Optional OpenRouter model preset tool (setup > Advanced Settings > Model preset tool).
# Budget shared with text-to-speech across jobs/workers; final request may exceed it.
AGENT_MODEL_SERVICE_ENABLED=false
AGENT_MODEL_SERVICE_ZDR_ONLY=false
AGENT_MODEL_SERVICE_BUDGET_USD=5.0
AGENT_MODEL_SERVICE_BUDGET_PERIOD_DAYS=30

# Optional dedicated text-to-speech tool (setup > Advanced Settings > Text-to-speech).
AGENT_TTS_ENABLED=false
AGENT_TTS_ZDR_ONLY=false


# =============================================================================
# AGENT IDENTITY
# =============================================================================
# These override agent.identity.name / agent.identity.email in YAML.
# Leave blank to use YAML defaults. If YAML is also blank:
#   - Name falls back to capitalized app name ("Assistant")
#   - Email falls back to SMTP_FROM → SMTP_USERNAME → "assistant@local"

AGENT_NAME=
AGENT_EMAIL=


# =============================================================================
# ADMIN & ORGANIZATION
# =============================================================================
# Admin receives approval requests and system notifications.
# ADMIN_EMAIL is required for core operation (approval emails go here).

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_TRUSTED_AUTHSERV_IDS=

# Organization identity for autonomous-agent disclosure footers.
# ORG_NAME appears in external email footers.
# ORG_SECURITY_EMAIL provides a contact for recipients.
# ORG_INTERNAL_EMAIL_DOMAINS (comma-separated) — recipients on these domains
# are considered internal and do not receive disclosure footers.
ORG_NAME=
ORG_SECURITY_EMAIL=
ORG_INTERNAL_EMAIL_DOMAINS=


# =============================================================================
# EMAIL — Required for email-driven operation
# =============================================================================
# Without IMAP settings, use the local administration CLI or opt-in HTTPS API.
# Without SMTP settings, the agent cannot send email (approvals, replies, etc).
#
# Set SMTP_HOST, SMTP_PORT, and SMTP_FROM so the agent can send approvals/results.

IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_FOLDER=INBOX
IMAP_ARCHIVE_FOLDER=Archive
IMAP_QUARANTINE_FOLDER=Quarantine
IMAP_SENT_FOLDER=Sent

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=


# =============================================================================
# EMAIL SAFETY GUARDRAILS
# =============================================================================
# EMAIL_ALLOWED_RECIPIENT_DOMAINS (comma-separated) — only these domains can
# receive outbound email. Admin email is always allowed regardless.
# Set to * to explicitly allow all recipient domains; rate limits still apply.
# EMAIL_ACTIONABLE_SENDERS (comma-separated) — only these senders can create
# new jobs via inbound email. Replies to open jobs still work from anyone.

EMAIL_ALLOWED_RECIPIENT_DOMAINS=
EMAIL_ACTIONABLE_SENDERS=


# =============================================================================
# CALENDAR (optional)
# =============================================================================
# Direct OAuth 2.0 access to Google Calendar, Microsoft Outlook, and/or Zoho.
# Calendar tools stay disabled until CALENDAR_ENABLED=true and at least one
# provider's CLIENT_ID / CLIENT_SECRET / REFRESH_TOKEN are set.
# Provider credentials are read from Docker secret files by CalendarRouter; they
# are not mapped into config/agent.yaml.
# See docs/calendar-providers.md for how to obtain credentials.

CALENDAR_ENABLED=
CALENDAR_DEFAULT_PROVIDER=
CALENDAR_DEFAULT_ALERT_MINUTES=

# Google Calendar
CALENDAR_GOOGLE_CALENDAR_ID=

# Microsoft Outlook / Microsoft 365
CALENDAR_OUTLOOK_TENANT_ID=

# Zoho Calendar
CALENDAR_ZOHO_API_BASE=


# =============================================================================
# ZOOM (optional) — credentials via ./scripts/setup.sh --section zoom
# =============================================================================

ZOOM_ENABLED=false
ZOOM_AUTH_MODE=s2s
ZOOM_USER_ID=me


# =============================================================================
# DROPBOX (optional) — credentials via ./scripts/setup.sh --section dropbox
# =============================================================================
# Private App Folder exchange; see docs/dropbox.md.

DROPBOX_ENABLED=false
DROPBOX_ALLOW_EXPORTS=false
DROPBOX_MAX_FILE_BYTES=26214400


# =============================================================================
# AGENT BEHAVIOR — Override operational defaults from config/agent.yaml
# =============================================================================
# These let you tune common settings without editing the YAML file.
# Leave blank to use the defaults from config/agent.yaml.
#
# The wizard manages these (./scripts/setup.sh --section advanced). Every other
# overridable setting belongs in overrides.env; see docs/env-overrides.md.

# Timezone for scheduling, reminders, and timestamps (IANA format).
# Default: UTC
AGENT_TIMEZONE=UTC

# Primary and fallback LLM models (OpenRouter model identifiers).
# Default: anthropic/claude-sonnet-4.6 / openai/gpt-5.4
AGENT_LLM_MODEL=
AGENT_LLM_FALLBACK_MODEL=

# Maximum outbound emails per hour (rate limit).
# Default: 10
AGENT_MAX_EMAILS_PER_HOUR=

# How often to poll IMAP for new messages (seconds).
# Default: 60
AGENT_IMAP_POLL_INTERVAL=


# =============================================================================
# DEPLOYMENT — Docker Compose publishing & scaling
# =============================================================================
# These are consumed by docker-compose.yml directly (not by the application).

# Optional HTTPS API publishing (there is no browser dashboard).
# Compose binds this port to host loopback only.
AGENT_API_PUBLISHED_PORT=8000

# Public URL used in admin emails and generated links.
# Overrides agent.app.base_url from YAML. Leave blank to use YAML default.
AGENT_APP_BASE_URL=https://localhost:8000

# API documentation exposure. Both are off by default — they expose a full
# enumeration of all API endpoints and should remain disabled unless you are
# developing locally and have no external network exposure.
AGENT_API_DOCS_ENABLED=false
AGENT_API_OPENAPI_ENABLED=false


# =============================================================================
# SECURITY — See docs/security.md for the full security guide
# =============================================================================

# Every API route requires HTTPS and bearer authentication. Setup creates the
# token and TLS configuration only when the api profile is explicitly selected.

AGENT_API_TLS_CERT_FILE=/run/assistant/tls/server.crt
AGENT_API_TLS_KEY_FILE=/run/assistant/tls/server.key

# Security screening (configure with ./scripts/setup.sh --section security).
# Admin DKIM/SPF check and an optional decision model. Once a model is
# enabled, inbound screening is always on; outbound email and scripts are opt-in.
# By default screening uses OpenRouter's Decisions API with OPENROUTER_API_KEY.
# Direct provider APIs use: ./scripts/setup.sh secrets update SECURITY_DECISION_API_KEY
AGENT_SECURITY_EMAIL_AUTH_ENABLED=false
AGENT_SECURITY_DECISION_ENABLED=false
# YOLO mode: let possibly malicious items run without approval. Not recommended.
AGENT_SECURITY_ALLOW_POSSIBLY_MALICIOUS=false


# =============================================================================
# SCALING
# =============================================================================

# Number of concurrent task-agent workers for parallel job processing.
TASK_AGENT_WORKERS=1

# Setup selects email for mailbox intake and api only when explicitly enabled.
# This preserves email-led startup for users adopting the template directly.
COMPOSE_PROFILES=email
